# =========================
# Environment variables
# =========================
.env
.env.*
!.env.example

# =========================
# Dataset (CMU Movie Summary Corpus)
# Keep folder structure, ignore contents
# =========================
datasets/*
!datasets/.gitkeep
dbVettoriale/*

# =========================
# Virtual environments
# =========================
.venv/
venv/
env/
ENV/

# =========================
# Python cache
# =========================
__pycache__/
*.py[cod]
*.pyo

# =========================
# Build artifacts
# =========================
build/
dist/
*.egg-info/

# =========================
# IDEs
# =========================
.vscode/
.idea/

# =========================
# macOS / Windows
# =========================
.DS_Store
Thumbs.db

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# Vector stores / RAG artifacts
# =========================
vectorstore/
qdrant_storage/
faiss_index/
indexes/

# =========================
# Local data & temp files
# =========================
dataset/
semanticDb/
data/
scripts/tmp/
tmp/
temp/

# =========================
# Large generated files
# =========================
*.npz
# =========================
# MovieLens data: unzipped CSV + generated SQLite DB (~2 GB, license forbids redistribution)
# Re-included after the global data/ rule so only .gitkeep is versioned.
# =========================
!movie_db/data/
movie_db/data/*
!movie_db/data/.gitkeep

# Local binaries (the Qdrant server is placed here, see scripts/start_qdrant.sh)
/bin/
