OPENAI_API_KEY=
COHERE_API_KEY=

VUE_APP_TMDB_API_KEY=

VUE_APP_TMDB_BASE_URL=

# Vector store for `python app.py`, the web API and buildSemanticDb.py. Leave empty for the default (qdrant,
# server at http://127.0.0.1:6333; see docs/qdrant_migration/server.md). Set VECTORSTORE_ENGINE=chroma to go back to Chroma.
# The Qdrant settings below are read only when the engine is qdrant.
VECTORSTORE_ENGINE=
VECTORSTORE_QDRANT_MODE=
VECTORSTORE_QDRANT_URL=
VECTORSTORE_QDRANT_PATH=
# Only for a Qdrant server that requires a key (Cloud or a secured deployment).
QDRANT_API_KEY=
