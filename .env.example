OPENAI_API_KEY=
COHERE_API_KEY=

VUE_APP_TMDB_API_KEY=

VUE_APP_TMDB_BASE_URL=

# Where the Qdrant index lives (read by `python app.py`, the web API and buildSemanticDb.py). Leave empty for the
# default: a Qdrant server at http://127.0.0.1:6333, started with ./scripts/start_qdrant.sh.
VECTORSTORE_QDRANT_MODE=
VECTORSTORE_QDRANT_URL=
VECTORSTORE_QDRANT_PATH=
# Only for a Qdrant server that requires a key (Cloud or a secured deployment).
QDRANT_API_KEY=

# OMDb API key (omdbapi.com/apikey.aspx; free: 1,000 requests a day, non-commercial use). Read only by tool/omdb/auth.py.
OMDB_API_KEY=
