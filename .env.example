OPENAI_API_KEY=

# Integrated runtime (default since FASE 24): cinema_sql on cinema_db/data/cinema.v4.candidate6.sqlite3 and series_rag_search are ON without these variables.
# Leave empty for the default; 0 / false / no / off switches the system off CINEMA_DB_PATH chooses another file.
CINEMA_DB_ENABLED=
CINEMA_DB_PATH=
SERIES_RAG_ENABLED=

VUE_APP_TMDB_API_KEY=

VUE_APP_TMDB_BASE_URL=

# Where the Qdrant server lives (read by `python app.py` and the web API; the two RAGs only read from it). Leave empty for the
# default: a server at http://127.0.0.1:6333, started with ./scripts/start_qdrant.sh.
VECTORSTORE_QDRANT_URL=

# OMDb API key (omdbapi.com/apikey.aspx; free: 1,000 requests a day, non-commercial use). Read only by tool/omdb/auth.py.
OMDB_API_KEY=

# ---- Only for rebuilding the data on a new machine (docs/REBUILD.md); the application does not read these ----
# Wikimedia asks every client that downloads from Wikidata to identify itself. Set it in the SHELL for the film pipeline's online run
# (RAGWIKI_WIKIDATA_CONTACT="https://github.com/<you>/<your fork>"): the URL of your repository is enough, no personal address needed.
# The paid steps refuse to start unless you authorise them in the shell for that one command (never write them here):
#   FILMS_EMBED_AUTHORIZED=yes    for `python -m pipelines.wikipedia_films.indexing.v3 embed`   (about 3.1 USD)
#   SERIES_EMBED_AUTHORIZED=yes   for `python -m pipelines.wikipedia_series.embed run`          (about 4.8 USD)
# Where the Qdrant binary is, if it is not in bin/qdrant or on the PATH (scripts/start_qdrant.sh):
# QDRANT_BIN=
# The it.wikipedia dump the data was built from is 20261101. Wikimedia keeps only the latest dumps, so on a new machine export the newest date
# (ITWIKI_DUMP_DATE=YYYYMMDD) and pass the same value as `--set dump.date=YYYYMMDD` to the film pipeline (docs/REBUILD.md, stage 1).
# ITWIKI_DUMP_DATE=
