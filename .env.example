OPENAI_API_KEY=

# Integrated runtime (default since FASE 24): cinema_sql on cinema_db/data/cinema.v4.candidate6.sqlite3 and series_rag_search are ON without these variables.
# Leave empty for the default; 0 / false / no / off switches the system off CINEMA_DB_PATH chooses another file.
CINEMA_DB_ENABLED=
CINEMA_DB_PATH=
SERIES_RAG_ENABLED=

VUE_APP_TMDB_API_KEY=

VUE_APP_TMDB_BASE_URL=

# Where the Qdrant server lives (read by `python app.py` and the web API; the two RAGs only read from it). Leave empty for the
# default: a server at http://127.0.0.1:6333, started with ./scripts/start_qdrant.sh.
VECTORSTORE_QDRANT_URL=

# OMDb API key (omdbapi.com/apikey.aspx; free: 1,000 requests a day, non-commercial use). Read only by tool/omdb/auth.py.
OMDB_API_KEY=
